# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会被提交）
# 变量名与 config.toml 里 [llm.*].api_key_env 对应，改配置时两边保持一致。

# LLM：任何 OpenAI 兼容端点（智谱 / DeepSeek / Kimi / OpenAI…）
RESEARCHWIKI_STRONG_API_KEY=
RESEARCHWIKI_CHEAP_API_KEY=

# 嵌入（阶段 3 的混合检索用；留空则用确定性的 MockEmbedding，检索仍可跑）
RESEARCHWIKI_EMBEDDING_API_KEY=

# 搜索（留空则回退 MockSearch，不联网也能跑完整个 loop）
TAVILY_API_KEY=
BOCHA_API_KEY=
